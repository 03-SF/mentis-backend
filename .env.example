# Environment Configuration
NODE_ENV=development
PORT=3001

# MongoDB Configuration
# Local MongoDB (if running locally)
# MONGODB_URI=mongodb://localhost:27017/mentis-ai
# MongoDB Atlas (Cloud - replace <db_password> with your actual password)
MONGODB_URI=mongodb+srv://mentis_user:<db_password>@mentis-ai.d3p8gur.mongodb.net/?appName=mentis-ai

# JWT Configuration
JWT_SECRET=mentis-ai-secret-key-change-in-production-to-something-very-secure
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=mentis-ai-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=30d

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# OpenAI Configuration (for AI recommendations)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Email Configuration (optional for email verification)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
